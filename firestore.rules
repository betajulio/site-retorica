rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null;
    }

    function emailKey() {
      return request.auth.token.email.lower();
    }

    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/approved_emails/$(emailKey()));
    }

    function isAuditAdmin() {
      return signedIn() && emailKey() == 'juliocereser@gmail.com';
    }

    function isPausedAdmin() {
      return exists(/databases/$(database)/documents/config/pausedAdmins)
        && ('emails' in get(/databases/$(database)/documents/config/pausedAdmins).data)
        && (emailKey() in get(/databases/$(database)/documents/config/pausedAdmins).data.emails);
    }

    function isAdminActive() {
      return isAuditAdmin() || (isMember() && !isPausedAdmin());
    }

    function isOwnApprovedEmailDoc(emailId) {
      return signedIn() && emailId == emailKey();
    }

    function publicConfigDoc(docId) {
      return docId in ['galleryTags', 'galleryCompression', 'pausedAdmins', 'loadingScreen', 'loading_screen'];
    }

    match /approved_emails/{emailId} {
      allow get: if isOwnApprovedEmailDoc(emailId) || isMember();
      allow list: if isMember();
      allow create, update, delete: if false;
    }

    match /members/{memberId} {
      allow read: if true;
      allow create, delete: if isAdminActive();
      allow update: if isMember();
    }

    match /suggestions/{suggestionId} {
      allow read: if true;
      allow create: if signedIn();
      allow update: if isAdminActive();
      allow delete: if isAuditAdmin();
    }

    match /polls/{pollId} {
      allow read: if true;
      allow create, update, delete: if isAdminActive();

      match /votes/{userId} {
        allow get: if signedIn() && request.auth.uid == userId;
        allow list: if false;
        allow create, update, delete: if isMember() && request.auth.uid == userId;
      }
    }

    match /setlists/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdminActive();
    }

    match /repertorio/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdminActive();
    }

    match /forum/{threadId} {
      allow read: if true;
      allow create, update, delete: if isAdminActive();

      match /posts/{postId} {
        allow read: if true;
        allow create, update, delete: if isAdminActive();
      }
    }

    match /gallery/{photoId} {
      allow read: if true;
      allow create: if isMember();
      allow delete: if isAdminActive();
      allow update: if isAdminActive()
        || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'commentCount', 'replyCount'])
        );

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn();
        allow update: if signedIn();
        allow delete: if isAdminActive();
      }
    }

    match /logs/{logId} {
      allow read, create: if isMember();
      allow delete: if isAdminActive();
      allow update: if false;
    }

    match /member_stats/{memberId} {
      allow read: if isMember();
      allow create, update: if isMember() && memberId == emailKey();
      allow delete: if false;
    }

    match /config/{docId} {
      allow read: if publicConfigDoc(docId)
        || ((docId == 'readAudit' || docId == 'bandRules') && isMember());
      allow create, update, delete: if ((docId == 'readAudit' || docId == 'bandRules' || docId == 'pausedAdmins') && isAuditAdmin())
        || (docId != 'readAudit' && docId != 'bandRules' && docId != 'pausedAdmins' && isAdminActive());
    }

    match /read_audit_events/{eventId} {
      allow read, delete: if isAuditAdmin();
      allow create: if isMember()
        && get(/databases/$(database)/documents/config/readAudit).data.enabled == true
        && get(/databases/$(database)/documents/config/readAudit).data.expiresAt > request.time
        && request.resource.data.auditId == get(/databases/$(database)/documents/config/readAudit).data.activeRunId;
      allow update: if false;
    }

    match /promotion_state/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdminActive();
    }

    match /rehearsal_state/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdminActive();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
