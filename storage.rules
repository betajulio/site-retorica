rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null;
    }

    function isMember() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/approved_emails/$(request.auth.token.email.lower()));
    }

    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
